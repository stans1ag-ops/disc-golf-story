{
  "name": "family-storybook",
  "version": "2.0.0",
  "private": true,
  "description": "A shared, accessible storybook built from scene records.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-site.cjs",
    "check": "node scripts/validate-site.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "preview": "node scripts/serve.cjs",
    "story": "python scripts/story.py"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}

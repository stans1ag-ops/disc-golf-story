{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/the-houghton-lake-patrol/",
      "destination": "/the-fish-that-pulled-back/",
      "permanent": true
    },
    {
      "source": "/the-houghton-lake-patrol",
      "destination": "/the-fish-that-pulled-back/",
      "permanent": true
    },
    {
      "source": "/the-houghton-lake-patrol/:path*",
      "destination": "/the-fish-that-pulled-back/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
